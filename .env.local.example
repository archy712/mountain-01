# 산길날씨(SanGil) 환경변수 예시
# 실제 값은 .env.local 에 채우세요 (.env.local 은 gitignore 대상).

# ── Supabase (클라이언트/서버 공용) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── 외부 API 서버 전용 키 (공공데이터포털, 클라이언트 노출 금지) ──
# 계정당 1키가 여러 서비스에 공용으로 쓰이면 동일 값을 넣어도 됩니다.
# 기상청 단기예보(초단기실황·초단기예보·단기예보)
KMA_SERVICE_KEY=
# 한국환경공단 에어코리아 대기오염정보
AIRKOREA_SERVICE_KEY=
# 기상청 생활기상지수 V5 (자외선 getUVIdxV5)
KMA_LIVING_INDEX_KEY=

# ── 지도 (Phase 5 / Task 028에서 사용) ───────────────────────────
# 카카오맵 JS 키. 발급 + 도메인 등록 후 설정. 그전까지 비워둬도 됩니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 참고: 탐방로 개방정보는 국립공원공단 정적 CSV로 대체되어 API 키가 필요 없습니다
# (docs/decisions/001-data-sources.md #4).
